[Unit]
Description=ONVIFscanner (Next.js)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=onvifscanner
Group=onvifscanner
WorkingDirectory=/opt/onvifscanner
EnvironmentFile=/etc/onvifscanner/onvifscanner.env
Environment=NODE_ENV=production
ExecStart=/usr/local/bin/onvifscanner-start
Restart=always
RestartSec=2
TimeoutStopSec=15
OOMPolicy=stop
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=-/opt/onvifscanner -/mnt -/media -/var/media

[Install]
WantedBy=multi-user.target
