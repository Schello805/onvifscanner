generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../data/onvifscanner.db"
}

model Camera {
  id              String   @id
  ip              String   @unique
  name            String
  hostname        String?
  manufacturer    String?
  model           String?
  resolution      String?
  snapshotUris    String // JSON array
  streamUris      String // JSON array
  username        String?
  password        String?
  overlayPosition String?
  savedAt         DateTime @default(now())
  sortOrder       Int      @default(0)

  recordEnabled             Boolean        @default(false)
  recordMode                String         @default("off") // off | motion | continuous
  recordSegmentMinutes      Int            @default(15)
  motionPreRollSeconds      Int            @default(10)
  motionPostRollSeconds     Int            @default(30)
  motionSensitivity         Int            @default(80)
  motionIgnoreRegions       String         @default("[]") // normalized rectangles: [{x,y,width,height}]
  objectDetectionEnabled    Boolean        @default(false)
  objectDetectionClasses    String         @default("[\"person\",\"vehicle\",\"animal\"]")
  objectMinConfidence       Int            @default(55)
  licensePlateRecognitionEnabled Boolean   @default(false)
  motionScheduleEnabled     Boolean        @default(false)
  motionScheduleStart       String         @default("22:00")
  motionScheduleEnd         String         @default("06:00")
  motionScheduleDays        String         @default("[0,1,2,3,4,5,6]")
  motionScheduleSensitivity Int            @default(90)
  motionEventState          String         @default("unknown") // unknown | probing | active | unsupported | error
  motionEventSource         String?
  motionEventLastSeen       DateTime?
  motionEventCheckedAt      DateTime?
  motionEventLastError      String?
  alarmCooldownSeconds      Int            @default(30)
  notificationsEnabled      Boolean        @default(false)
  storageTargetId           String?
  storageTarget             StorageTarget? @relation(fields: [storageTargetId], references: [id], onDelete: SetNull)

  status           DeviceStatus?
  statusLogs       CameraStatusLog[]
  alarms           AlarmLog[]
  motionRecordings MotionRecording[]
}

model StorageTarget {
  id             String   @id @default(cuid())
  name           String
  path           String   @unique
  isDefault      Boolean  @default(false)
  enabled        Boolean  @default(true)
  maxDays        Int      @default(14)
  minFreeSpaceGb Int      @default(10)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cameras Camera[]
}

model DeviceStatus {
  id           String   @id @default(cuid())
  cameraId     String   @unique
  camera       Camera   @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  isOnline     Boolean  @default(true)
  lastSeen     DateTime @default(now())
  pingFailures Int      @default(0)
}

model CameraStatusLog {
  id        String   @id @default(cuid())
  cameraId  String
  camera    Camera   @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  status    String // online | offline
  timestamp DateTime @default(now())

  @@index([cameraId, timestamp])
  @@index([timestamp])
}

model Settings {
  id                          String   @id @default("default")
  columns                     Int?
  refresh                     Int?
  autoCleanup                 Boolean? @default(true)
  ntfyTopic                   String?
  ntfyServer                  String?
  ntfyCameraStatusEnabled     Boolean  @default(false)
  motionSensitivityV3Migrated Boolean  @default(false)
}

model DiscoveredDevice {
  id           String   @id
  ip           String
  name         String
  hostname     String?
  manufacturer String?
  model        String?
  snapshotUris String // JSON array
  streamUris   String // JSON array
  username     String?
  password     String?
  discoveredAt DateTime @default(now())
}

model AlarmLog {
  id                String           @id @default(cuid())
  cameraId          String
  camera            Camera           @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  timestamp         DateTime         @default(now())
  imageUrl          String? // base64 or path
  message           String?
  objectClasses     String?
  objectDetections  String?
  motionRecordingId String?
  motionRecording   MotionRecording? @relation(fields: [motionRecordingId], references: [id], onDelete: SetNull)

  @@index([motionRecordingId])
}

model MotionRecording {
  id           String     @id @default(cuid())
  cameraId     String
  camera       Camera     @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  startedAt    DateTime
  endedAt      DateTime
  status       String     @default("buffering") // buffering | merging | ready | failed | deleted
  filePath     String?
  segmentCount Int        @default(0)
  error        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  events       AlarmLog[]

  @@index([cameraId, status])
  @@index([startedAt])
}
