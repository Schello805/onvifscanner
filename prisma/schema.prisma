generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../data/onvifscanner.db"
}

model Camera {
  id              String   @id
  ip              String   @unique
  name            String
  hostname        String?
  manufacturer    String?
  model           String?
  snapshotUris    String   // JSON array
  streamUris      String   // JSON array
  username        String?
  password        String?
  overlayPosition String?
  savedAt         DateTime @default(now())
  sortOrder       Int      @default(0)
  
  recordEnabled        Boolean  @default(false)
  recordSegmentMinutes Int      @default(15)
  storageTargetId      String?
  storageTarget        StorageTarget? @relation(fields: [storageTargetId], references: [id], onDelete: SetNull)

  status          DeviceStatus?
  alarms          AlarmLog[]
}

model StorageTarget {
  id              String   @id @default(cuid())
  name            String
  path            String   @unique
  isDefault       Boolean  @default(false)
  enabled         Boolean  @default(true)
  maxDays         Int      @default(14)
  minFreeSpaceGb  Int      @default(10)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  cameras         Camera[]
}

model DeviceStatus {
  id         String   @id @default(cuid())
  cameraId   String   @unique
  camera     Camera   @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  isOnline   Boolean  @default(true)
  lastSeen   DateTime @default(now())
  pingFailures Int    @default(0)
}

model Settings {
  id          String   @id @default("default")
  columns     Int?
  refresh     Int?
  autoCleanup Boolean? @default(true)
}

model DiscoveredDevice {
  id              String   @id
  ip              String
  name            String
  hostname        String?
  manufacturer    String?
  model           String?
  snapshotUris    String   // JSON array
  streamUris      String   // JSON array
  username        String?
  password        String?
  discoveredAt    DateTime @default(now())
}

model AlarmLog {
  id         String   @id @default(cuid())
  cameraId   String
  camera     Camera   @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  timestamp  DateTime @default(now())
  imageUrl   String?  // base64 or path
  message    String?
}
