# App / UI
NEXT_PUBLIC_REPO_URL=https://github.com/Schello805/onvifscanner
# NEXT_PUBLIC_STUN_SERVER=stun:stun.l.google.com:19302 # Optional: STUN-Server für WAN-WebRTC (im LAN nicht erforderlich)

# Scanning limits
ALLOW_PUBLIC_SCAN=false
SCAN_MAX_HOSTS=4096
SCAN_CONCURRENCY=128
SCAN_TIMEOUT_MS=1200
WS_DISCOVERY_TIMEOUT_MS=1800

# Thumbnails (ONVIF snapshots)
ENABLE_THUMBNAILS=true
THUMBNAILS_MAX=12

# Hardware-Beschleunigung (auto | vaapi | qsv | videotoolbox | cuda | cpu)
# FFMPEG_HWACCEL=auto

# Objekterkennung Modell-Basis (lite_mobilenet_v2 | mobilenet_v1 | mobilenet_v2)
# OBJECT_DETECTION_MODEL_BASE=lite_mobilenet_v2
# OBJECT_DETECTION_MAX_RSS_MB=512
# OBJECT_DETECTION_INIT_TIMEOUT_MS=90000
# OBJECT_DETECTION_TIMEOUT_MS=25000
# OBJECT_DETECTION_RETRY_MS=30000

# CPU-schonende serverseitige Bewegungserkennung
ENABLE_MOTION_DETECTION=true
MOTION_DETECTION_INTERVAL_MS=3000
MOTION_DETECTION_CONCURRENCY=2
MOTION_CONFIRMATION_FRAMES=2
MOTION_ANALYSIS_WIDTH=192
MOTION_SOURCE_WIDTH=640

