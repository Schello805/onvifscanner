{
  "name": "onvifscanner",
  "version": "0.15.8",
  "private": true,
  "description": "Local-first camera discovery, monitoring and NVR for ONVIF/RTSP cameras.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Your Name <you@example.com>",
  "scripts": {
    "clean": "rm -rf .next .next-dev",
    "dev:clean": "rm -rf .next-dev && NEXT_DIST_DIR=.next-dev next dev",
    "dev:fast": "NEXT_DIST_DIR=.next-dev next dev",
    "dev": "npm run dev:clean",
    "prebuild": "rm -rf .next",
    "build": "next build",
    "start": "NODE_ENV=production node server.js",
    "lint": "next lint",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:motion-policy": "node scripts/test-motion-policy.js",
    "test:object-detection-policy": "node scripts/test-object-detection-policy.js",
    "update": "bash scripts/update.sh"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "framer-motion": "^14.1.0",
    "jimp": "^1.6.1",
    "lucide-react": "^1.8.0",
    "next": "^14.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.34.5",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.13",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "daisyui": "^5.5.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "postcss": "^8.4.38",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.4"
  },
  "allowScripts": {
    "prisma@5.22.0": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true
  },
  "optionalDependencies": {
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0"
  }
}
