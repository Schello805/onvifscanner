{
  "name": "onvifscanner",
  "version": "0.20.3",
  "private": true,
  "description": "Local-first camera discovery, monitoring and NVR for ONVIF/RTSP cameras.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Your Name <you@example.com>",
  "scripts": {
    "clean": "rm -rf .next .next-dev",
    "dev:clean": "rm -rf .next-dev && NEXT_DIST_DIR=.next-dev next dev",
    "dev:fast": "NEXT_DIST_DIR=.next-dev next dev",
    "dev": "npm run dev:clean",
    "build": "node scripts/build.js",
    "start": "NODE_ENV=production node server.js",
    "lint": "next lint",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:playback": "node scripts/test-playback.js",
    "test:playback:browser": "node scripts/test-playback-browser.js",
    "test:recording": "node scripts/test-recording.js",
    "test:recording:api": "node scripts/test-recording-api.js",
    "test:recording:rtsp": "node scripts/test-recording-rtsp.js",
    "test:legacy-rtsp": "node scripts/test-legacy-rtsp.js",
    "test:legacy-rtsp:integration": "node scripts/test-legacy-rtsp-integration.js",
    "test": "npm run test:motion-policy && npm run test:object-detection-policy && npm run test:object-detector && npm run test:build && npm run test:license-plate-reader && npm run test:image-annotator && npm run test:legacy-rtsp",
    "test:object-detector": "node scripts/test-object-detector.js",
    "test:build": "node scripts/test-build.js",
    "test:motion-policy": "node scripts/test-motion-policy.js",
    "test:object-detection-policy": "node scripts/test-object-detection-policy.js",
    "test:license-plate-reader": "node scripts/test-license-plate-reader.js",
    "test:image-annotator": "node scripts/test-image-annotator.js",
    "reset-password": "node scripts/reset-password.js",
    "update": "bash scripts/update.sh",
    "rollback": "bash scripts/rollback.sh"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "framer-motion": "^14.1.0",
    "hls.js": "^1.7.3",
    "jimp": "^1.6.1",
    "lucide-react": "^1.8.0",
    "next": "^14.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.13",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.19",
    "daisyui": "^5.5.19",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "playwright": "^1.64.1",
    "postcss": "^8.4.38",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.4"
  },
  "allowScripts": {
    "esbuild": true,
    "prisma@5.22.0": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true
  },
  "optionalDependencies": {
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0"
  }
}
